usuarios = []

logado = False
usuario_logado = ""

while True:
    print("\033c", end="") # comando para limpar a tela
    print("#########################################")
    print("SISTEMA DE CADASTRO DE USUÁRIOS")
    print("#########################################\n")

    if not logado:
        print("===LOGIN===")
        login = input("Digite seu login: ")
        senha = input("Digite sua senha: ")

        if login == "admin" and senha == "123":
            print(f"Login realizado com sucesso! Bem-vindo, {login}!\n")
            input("ENTER para continuar...")
            logado = True
            usuario_logado = login
        else:
            input("\nLogin ou senha incorretos! ENTER para tentar novamente.")

    else:
        print("===MENU PRINCIPAL===")
        print(f"Usuário logado: {usuario_logado}")
        print("1 - Inserir usuário")
        print("2 - Pesquisar usuário")
        print("3 - Remover usuário")
        print("4 - Listar todos os usuários")
        print("5 - Logout")
        print("6 - Encerrar")

        opcao = input("Escolha uma opção: ")

        if opcao == "1":
            nome = input("Digite o nome do usuário: ").strip()

            if nome != "" and nome.lower() not in [u.lower() for u in usuarios]:
                usuarios.append(nome)
                print(f"\nUsuário {nome} cadastrado com sucesso!")
            elif nome == "":
                print("\nNome inválido! Digite um nome.")
            else:
                print("\nEste usuário já está cadastrado!")

            input("ENTER para continuar...")

        elif opcao == "2":
            nome = input("Digite o nome que deseja pesquisar: ").strip()

            encontrado = False

            for usuario in usuarios:
                if usuario.lower() == nome.lower():
                    print(f"\nUsuário {usuario} encontrado!")
                    encontrado = True
                    break

            if not encontrado:
                print(f"\nUsuário {nome} não encontrado!")

            input("ENTER para continuar...")

        elif opcao == "3":
            nome = input("Digite o nome que deseja remover: ").strip()

            encontrado = False

            for usuario in usuarios:
                if usuario.lower() == nome.lower():
                    usuarios.remove(usuario)
                    print(f"\nUsuário {usuario} removido com sucesso!")
                    encontrado = True
                    break

            if not encontrado:
                print(f"\nUsuário {nome} não encontrado!")

            input("ENTER para continuar...")

        elif opcao == "4":
            print("\n=== LISTA DE USUÁRIOS ===")

            if len(usuarios) == 0:
                print("Nenhum usuário cadastrado.")
            else:
                for usuario in usuarios:
                    print(usuario)

            input("\nENTER para continuar...")

        elif opcao == "5":
            print("Fazendo logout...")
            input("ENTER para voltar para o login.")
            usuario_logado = ""
            logado = False

        elif opcao == "6":
            print("Encerrando o sistema... Até logo!")
            break

        else:
            input("Opção inválida! ENTER para continuar...")
